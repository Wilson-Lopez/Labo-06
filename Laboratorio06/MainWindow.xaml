<Window x:Class="Laboratorio06.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestión General - Neptuno" Height="620" Width="950"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <TextBlock Text="Mantenimiento de Productos" 
                   FontSize="20" FontWeight="Bold" Foreground="#1E3A8A" Margin="0,0,0,15"/>

        <!-- Formulario y Botones -->
        <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <StackPanel Orientation="Vertical">
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="ID Producto:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="5"/>
                    <TextBox x:Name="txtIdProducto" Grid.Row="0" Grid.Column="1" IsReadOnly="True" Background="#E2E8F0" Margin="5"/>

                    <TextBlock Text="Nombre:" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Margin="5"/>
                    <TextBox x:Name="txtNombre" Grid.Row="0" Grid.Column="3" Margin="5"/>

                    <TextBlock Text="Precio:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="5"/>
                    <TextBox x:Name="txtPrecio" Grid.Row="1" Grid.Column="1" Margin="5"/>

                    <TextBlock Text="Stock:" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Margin="5"/>
                    <TextBox x:Name="txtStock" Grid.Row="1" Grid.Column="3" Margin="5"/>
                </Grid>

                <!-- Panel de Botones CRUD + Navegación -->
                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Button x:Name="btnNuevo" Content="Nuevo" Width="85" Height="32" Margin="4" Click="btnNuevo_Click"/>
                    <Button x:Name="btnGuardar" Content="Guardar" Width="85" Height="32" Margin="4" Background="#16A34A" Foreground="White" Click="btnGuardar_Click"/>
                    <Button x:Name="btnActualizar" Content="Actualizar" Width="85" Height="32" Margin="4" Background="#CA8A04" Foreground="White" Click="btnActualizar_Click"/>
                    <Button x:Name="btnEliminar" Content="Eliminar" Width="85" Height="32" Margin="4" Background="#DC2626" Foreground="White" Click="btnEliminar_Click"/>

                    <!-- BOTONES DE NAVEGACIÓN A LAS OTRAS VISTAS -->
                    <Button x:Name="btnProveedores" Content="Ver Proveedores" Width="130" Height="32" Margin="12,4,4,4" Background="#475569" Foreground="White" FontWeight="Bold" Click="btnProveedores_Click"/>
                    <Button x:Name="btnPedidos" Content="Ver Pedidos" Width="110" Height="32" Margin="4" Background="#475569" Foreground="White" FontWeight="Bold" Click="btnPedidos_Click"/>
                    <Button x:Name="btnAbrirReporte" Content="Ver Reporte Pedidos" Width="140" Height="32" Margin="4" Background="#2563EB" Foreground="White" FontWeight="Bold" Click="btnAbrirReporte_Click"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Tabla DataGrid de Productos -->
        <DataGrid x:Name="dgProductos" Grid.Row="2" 
                  AutoGenerateColumns="True" 
                  IsReadOnly="True" 
                  SelectionMode="Single"
                  AlternatingRowBackground="#F1F5F9" 
                  GridLinesVisibility="Horizontal"
                  SelectionChanged="dgProductos_SelectionChanged"/>
    </Grid>
</Window>
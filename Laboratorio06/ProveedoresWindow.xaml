<Window x:Class="Laboratorio06.ProveedoresWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestión de Proveedores" Height="650" Width="950"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Mantenimiento y Búsqueda de Proveedores" 
                   FontSize="20" FontWeight="Bold" Foreground="#1E3A8A" Margin="0,0,0,10"/>

        <!-- Filtros de Búsqueda -->
        <GroupBox Header="Filtro de Búsqueda" Grid.Row="1" Margin="0,0,0,10" Padding="10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Contacto:" VerticalAlignment="Center" Margin="5"/>
                <TextBox x:Name="txtBuscarContacto" Width="150" Margin="5"/>

                <TextBlock Text="Ciudad:" VerticalAlignment="Center" Margin="5"/>
                <TextBox x:Name="txtBuscarCiudad" Width="150" Margin="5"/>

                <Button x:Name="btnBuscar" Content="Buscar / Filtrar" Width="120" Height="28" Margin="10,0,5,0" Click="btnBuscar_Click"/>
                <Button x:Name="btnLimpiarFiltro" Content="Mostrar Todos" Width="120" Height="28" Margin="5,0,0,0" Click="btnLimpiarFiltro_Click"/>
            </StackPanel>
        </GroupBox>

        <!-- Formulario CRUD -->
        <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
            <StackPanel Orientation="Vertical">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="ID Proveedor:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="5"/>
                    <TextBox x:Name="txtIdProveedor" Grid.Row="0" Grid.Column="1" IsReadOnly="True" Background="#E2E8F0" Margin="5"/>

                    <TextBlock Text="Compañía:" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Margin="5"/>
                    <TextBox x:Name="txtCompania" Grid.Row="0" Grid.Column="3" Margin="5"/>

                    <TextBlock Text="Contacto:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="5"/>
                    <TextBox x:Name="txtContacto" Grid.Row="1" Grid.Column="1" Margin="5"/>

                    <TextBlock Text="Ciudad:" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Margin="5"/>
                    <TextBox x:Name="txtCiudad" Grid.Row="1" Grid.Column="3" Margin="5"/>

                    <TextBlock Text="Teléfono:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="5"/>
                    <TextBox x:Name="txtTelefono" Grid.Row="2" Grid.Column="1" Margin="5"/>

                    <TextBlock Text="País:" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" Margin="5"/>
                    <TextBox x:Name="txtPais" Grid.Row="2" Grid.Column="3" Margin="5"/>
                </Grid>

                <WrapPanel HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Button x:Name="btnNuevo" Content="Nuevo" Width="90" Height="28" Margin="5" Click="btnNuevo_Click"/>
                    <Button x:Name="btnGuardar" Content="Guardar" Width="90" Height="28" Margin="5" Background="#16A34A" Foreground="White" Click="btnGuardar_Click"/>
                    <Button x:Name="btnActualizar" Content="Actualizar" Width="90" Height="28" Margin="5" Background="#CA8A04" Foreground="White" Click="btnActualizar_Click"/>
                    <Button x:Name="btnEliminar" Content="Eliminar" Width="90" Height="28" Margin="5" Background="#DC2626" Foreground="White" Click="btnEliminar_Click"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- DataGrid -->
        <DataGrid x:Name="dgProveedores" Grid.Row="3" AutoGenerateColumns="True" IsReadOnly="True" 
                  SelectionMode="Single" AlternatingRowBackground="#F1F5F9" SelectionChanged="dgProveedores_SelectionChanged"/>
    </Grid>
</Window>
<Window x:Class="Laboratorio06.ReportePedidosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reporte de Detalle de Pedidos" Height="450" Width="800"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Reporte de Pedidos por Rango de Fechas" 
                   FontSize="18" FontWeight="Bold" Margin="0,0,0,15" Foreground="#1E3A8A"/>

        <!-- Filtros de Fecha -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="Fecha Inicio:" VerticalAlignment="Center" Margin="5"/>
            <DatePicker x:Name="dtpInicio" Width="130" Margin="5"/>

            <TextBlock Text="Fecha Fin:" VerticalAlignment="Center" Margin="5"/>
            <DatePicker x:Name="dtpFin" Width="130" Margin="5"/>

            <Button x:Name="btnBuscar" Content="Consultar Reporte" Width="130" Height="30" Margin="15,0,0,0" Click="btnBuscar_Click"/>
        </StackPanel>

        <!-- DataGrid -->
        <DataGrid x:Name="dgReporte" Grid.Row="2" AutoGenerateColumns="True" IsReadOnly="True" AlternatingRowBackground="#F3F4F6"/>
    </Grid>
</Window>